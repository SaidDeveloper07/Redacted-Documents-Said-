      margin: 20px 0 8px;
      font-size: 1.05rem;
      color: var(--orange);
    }
    p { margin: 0 0 12px; }
    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 16px 18px;
      margin: 12px 0;
